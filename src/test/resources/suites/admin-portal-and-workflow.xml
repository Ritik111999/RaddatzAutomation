<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Raddatz Client Portal and Workflow Suite" parallel="none">
    <parameter name="reuseBrowser" value="true"/>
    <listeners>
        <listener class-name="com.raddatz.automation.reports.ExtentTestListener"/>
    </listeners>

    <test name="Client Portal Spreadsheets, Documents &amp; Workflow Contracts" preserve-order="true">
        <classes>
            <class name="com.raddatz.automation.tests.AdminClientPortalAndWorkflowTest"/>
        </classes>
    </test>
</suite>
