<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Raddatz Local Admin Regression Suite - Serial Execution" parallel="none" thread-count="1">
    <parameter name="reuseBrowser" value="true"/>
    <listeners>
        <listener class-name="com.raddatz.automation.reports.ExtentTestListener"/>
    </listeners>

    <test name="Stage 1 - System Preflight and Search Filters" preserve-order="true">
        <classes>
            <class name="com.raddatz.automation.tests.ReadOnlySmokeTest"/>
            <class name="com.raddatz.automation.tests.AdminSearchFilterTest"/>
        </classes>
    </test>

    <test name="Stage 2 - Form Field Contracts and Boundary Constraints" preserve-order="true">
        <classes>
            <class name="com.raddatz.automation.tests.AdminFormContractObservationTest"/>
            <class name="com.raddatz.automation.tests.AdminDomainIntegrityNegativeTest"/>
        </classes>
    </test>

    <test name="Stage 3 - Client Portfolio Hierarchy Lifecycle" preserve-order="true">
        <classes>
            <class name="com.raddatz.automation.tests.AdminCompanyCreationTest"/>
            <class name="com.raddatz.automation.tests.AdminPropertyCreationTest"/>
            <class name="com.raddatz.automation.tests.AdminMatterCreationTest"/>
            <class name="com.raddatz.automation.tests.AdminMultiTenantMatterTest"/>
            <class name="com.raddatz.automation.tests.AdminOwnedHierarchyEditTest"/>
            <class name="com.raddatz.automation.tests.AdminPortfolioHierarchyTest"/>
        </classes>
    </test>

    <test name="Stage 4 - Matter 360 Operations and Case Evidence" preserve-order="true">
        <classes>
            <class name="com.raddatz.automation.tests.AdminTaskLifecycleTest"/>
            <class name="com.raddatz.automation.tests.AdminEventLifecycleTest"/>
            <class name="com.raddatz.automation.tests.AdminTaskAndEventCreationTest"/>
            <class name="com.raddatz.automation.tests.AdminMatterNoteLifecycleTest"/>
            <class name="com.raddatz.automation.tests.AdminMatterDocumentLifecycleTest"/>
        </classes>
    </test>

    <test name="Stage 5 - Cross-Screen Workflows and Multi-Hub Propagation" preserve-order="true">
        <classes>
            <class name="com.raddatz.automation.tests.AdminCrossScreenWorkflowTest"/>
        </classes>
    </test>

    <test name="Stage 6 - Document Template Engine and Variable Generation" preserve-order="true">
        <classes>
            <class name="com.raddatz.automation.tests.AdminDocumentTemplateMetadataLifecycleTest"/>
            <class name="com.raddatz.automation.tests.AdminDocumentVariableGenerationTest"/>
        </classes>
    </test>

    <test name="Stage 7 - Court Updates and Financial Billing Pipeline" preserve-order="true">
        <classes>
            <class name="com.raddatz.automation.tests.AdminCourtUpdateLifecycleTest"/>
            <class name="com.raddatz.automation.tests.AdminCourtUpdateBillingE2ETest"/>
            <class name="com.raddatz.automation.tests.AdminConsolidatedMatterBillingE2ETest"/>
            <class name="com.raddatz.automation.tests.AdminHumanBillingAndEdgeTest"/>
            <class name="com.raddatz.automation.tests.AdminOwnedTimeEntryLifecycleTest"/>
            <class name="com.raddatz.automation.tests.AdminOwnedExpenseLifecycleTest"/>
            <class name="com.raddatz.automation.tests.AdminTimeEntryInvoicePropagationTest"/>
            <class name="com.raddatz.automation.tests.AdminOwnedInvoiceDraftTest"/>
        </classes>
    </test>

    <test name="Stage 8 - Master End-to-End Business Journey" preserve-order="true">
        <classes>
            <class name="com.raddatz.automation.tests.AdminFullLifecycleE2ETest"/>
        </classes>
    </test>
</suite>
