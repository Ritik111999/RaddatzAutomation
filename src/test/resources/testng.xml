<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Raddatz PWA Automation" parallel="none">
    <listeners>
        <listener class-name="com.raddatz.automation.reports.ExtentTestListener"/>
    </listeners>
    <test name="Admin-panel read-only smoke tests">
        <groups>
            <run>
                <include name="admin-readonly"/>
            </run>
        </groups>
        <classes>
            <class name="com.raddatz.automation.tests.ReadOnlySmokeTest"/>
        </classes>
    </test>
</suite>
